{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=github_discord_notifier;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAVerySecureSecretKeyForJWTTokenGenerationPleaseChangeInProduction",
    "Issuer": "GitHubDiscordNotifier",
    "Audience": "GitHubDiscordNotifierUsers",
    "TokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Frontend": {
    "Url": "http://localhost:8080"
  },
  "AllowedHosts": "*"
}